DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
JWT_SECRET=your-random-32-character-secret-key

# AI Provider (Free Google Gemini API recommended; or Groq API; or leave unset for built-in fallback)
GEMINI_API_KEY=your-free-gemini-api-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Imagery & CORS
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
FRONTEND_ORIGINS=http://localhost:5173,https://wayfare-travel-planner-black.vercel.app
